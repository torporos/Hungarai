  "grammar": [
    {
      "id": "q1-mnozne-cislo",
      "title_cs": "Množné číslo: koncovka -k",
      "level": "Q1 · ZÁKLADNÍ TVARY",
      "summary_cs": "Koncovka -k tvoří množné číslo; před ní se často vloží samohláska podle zakončení a harmonie.",
      "rule_cs": "Po samohlásce obvykle připojte -k: csákó → csákók. Po souhlásce se často vloží harmonická samohláska: gomb → gombok, ing → ingek. Některá slova mění kmen nebo délku samohlásky, proto se učte celý tvar.",
      "groups": [
        {
          "name_cs": "Věci v kasárnách",
          "suffix_hu": "-k",
          "examples": [
            {
              "form_hu": "csákó → csákók",
              "translation_cs": "čákó (jeden kus) → více čákó"
            },
            {
              "form_hu": "gomb → gombok",
              "translation_cs": "knoflík → knoflíky"
            },
            {
              "form_hu": "ing → ingek",
              "translation_cs": "košile (jedna) → košile (množné číslo)"
            },
            {
              "form_hu": "ágy → ágyak",
              "translation_cs": "postel → postele"
            }
          ]
        }
      ],
      "notes_cs": [
        "Po zadních samohláskách bývá vkládací samohláska -o/-a; po předních často -e/-ö.",
        "Jednotlivé tvary se mohou lišit, například csizma → csizmák; množné číslo se proto procvičuje spolu se slovem."
      ],
      "tags": [
        "q1",
        "plural_formation"
      ]
    }
  ],
