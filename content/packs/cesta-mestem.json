  "grammar": [
    {
      "id": "smer-dovnitr",
      "title_cs": "Směr dovnitř: -ba / -be",
      "level": "A1 · KONCOVKY",
      "summary_cs": "Koncovky -ba a -be říkají, že někdo nebo něco míří dovnitř.",
      "rule_cs": "Stejně jako u dalších maďarských přípon vybíráme variantu podle samohláskové harmonie.",
      "groups": [
        {
          "name_cs": "Zadní varianta",
          "suffix_hu": "-ba",
          "examples": [
            {
              "form_hu": "a házba",
              "translation_cs": "do domu"
            },
            {
              "form_hu": "a táskába",
              "translation_cs": "do tašky"
            }
          ]
        },
        {
          "name_cs": "Přední varianta",
          "suffix_hu": "-be",
          "examples": [
            {
              "form_hu": "a kertbe",
              "translation_cs": "na zahradu"
            },
            {
              "form_hu": "a könyvbe",
              "translation_cs": "do knihy"
            }
          ]
        }
      ],
      "notes_cs": [
        "Porovnejte: a házban = v domě, ale a házba = do domu.",
        "Po slovesech pohybu se často používá tvar vyjadřující směr."
      ]
    },
    {
      "id": "pohybova-slova",
