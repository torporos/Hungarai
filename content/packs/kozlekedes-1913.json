  "grammar": [
    {
      "id": "prepravni-prostredek-val-vel",
      "title_cs": "Čím jedu? Koncovka -val/-vel",
      "level": "A1 · MĚSTO V ROCE 1913",
      "summary_cs": "Koncovka -val/-vel vyjadřuje prostředek nebo doprovod.",
      "rule_cs": "Po samohlásce připojte -val/-vel podle harmonie. Po souhlásce se počáteční v v koncovce přizpůsobí poslední souhlásce slova; v pravopisu se tato souhláska zdvojí: kocsi + -val = kocsival, villamos + -val = villamossal.",
      "groups": [
        {
          "name_cs": "Cesta městem",
          "suffix_hu": "-val / -vel",
          "examples": [
            {
              "form_hu": "kocsi + -val → kocsival",
              "translation_cs": "kočár → kočárem"
            },
            {
              "form_hu": "villamos + -val → villamossal",
              "translation_cs": "tramvaj → tramvají"
            },
            {
              "form_hu": "ló + -val → lóval",
              "translation_cs": "kůň → s koněm"
            }
          ]
        }
      ],
      "notes_cs": [
        "U slov zakončených souhláskou se v -val/-vel zdvojí poslední souhláska: vonat + -val = vonattal.",
        "Význam závisí na větě: villamossal megy = jede tramvají; lóval van = je s koněm."
      ]
    }
  ],
