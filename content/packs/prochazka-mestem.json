  "grammar": [
    {
      "id": "poloha-na-povrchu",
      "title_cs": "Poloha na místě: -n / -on / -en / -ön",
      "level": "A1 · DALŠÍ MÍSTNÍ KONCOVKY",
      "summary_cs": "Pro polohu na náměstí nebo na mostě se používá další skupina místních koncovek.",
      "rule_cs": "U slov zakončených samohláskou často připojíme -n. Po souhlásce vybíráme -on, -en nebo -ön podle harmonie. Konkrétní podobu je dobré ověřit na daném slově; existují i ustálené výjimky.",
      "groups": [
        {
          "name_cs": "Po samohlásce a na náměstí",
          "suffix_hu": "-n / -en",
          "examples": [
            {
              "form_hu": "folyó → folyón",
              "translation_cs": "řeka → na řece"
            },
            {
              "form_hu": "tér → téren",
              "translation_cs": "náměstí → na náměstí"
            },
            {
              "form_hu": "A múzeum a téren van.",
              "translation_cs": "Muzeum je na náměstí."
            }
          ]
        },
        {
          "name_cs": "Varianty po souhlásce",
          "suffix_hu": "-on / -en / -ön",
          "examples": [
            {
              "form_hu": "híd → hídon",
              "translation_cs": "most → na mostě"
            },
            {
              "form_hu": "asztal → asztalon",
              "translation_cs": "stůl → na stole"
            },
            {
              "form_hu": "A híd közel van.",
              "translation_cs": "Most je blízko."
            }
          ]
        }
      ],
      "notes_cs": [
        "Slovo híd obsahuje přední neutrální í, přesto má ustálený tvar hídon.",
        "Srovnejte význam: a parkban = v parku, a téren = na náměstí.",
        "Koncovka pro povrch nebo místo není vždy doslovný překlad českého předložkového pádu."
      ],
      "tags": [
        "q2",
        "superessive_on_en_on"
      ]
    }
  ],
