  "grammar": [
    {
      "id": "birtokos-m",
      "title_cs": "Přivlastnění: moje věc nebo osoba",
      "level": "A1 · RODINA",
      "summary_cs": "Maďarština připojuje „můj/moje“ přímo ke jménu.",
      "rule_cs": "Pro přivlastnění v 1. osobě jednotného čísla připojíme k podstatnému jménu příponu. Podoba se řídí harmonií a zakončením slova: často -om/-em po souhlásce, zatímco slova končící na -a mohou délku samohlásky změnit.",
      "groups": [
        {
          "name_cs": "Přítel a rodina",
          "suffix_hu": "-om / -em",
          "examples": [
            {
              "form_hu": "barát → barátom",
              "translation_cs": "přítel → můj přítel"
            },
            {
              "form_hu": "család → családom",
              "translation_cs": "rodina → moje rodina"
            },
            {
              "form_hu": "vendég → vendégem",
              "translation_cs": "host → můj host"
            },
            {
              "form_hu": "testvér → testvérem",
              "translation_cs": "sourozenec → můj sourozenec"
            }
          ]
        },
        {
          "name_cs": "Slova zakončená na -a",
          "suffix_hu": "-m",
          "examples": [
            {
              "form_hu": "anya → anyám",
              "translation_cs": "matka → moje matka"
            },
            {
              "form_hu": "apa → apám",
              "translation_cs": "otec → můj otec"
            }
          ]
        }
      ],
      "notes_cs": [
        "Přípona se připojuje ke slovu; české „můj/moje“ stojí zvlášť, maďarsky je součástí slova.",
        "Neučte se jen samotnou příponu: zapamatujte si i změny kmene, například anya → anyám."
      ]
    },
    {
      "id": "casovani-prvni-osoba",
      "title_cs": "Slovesa: „já“ v přítomném čase",
      "level": "A1 · MŮJ DEN",
      "summary_cs": "Slovníkový tvar slovesa se při „já“ mění podle osobní koncovky.",
      "rule_cs": "Maďarská slovesa se ve slovníku běžně uvádějí ve 3. osobě jednotného čísla. Pro jednoduchý přítomný čas v 1. osobě přidáme osobní koncovku; její podoba závisí na harmonii i na tvaru slovesa.",
      "groups": [
        {
          "name_cs": "Základní tvary v první osobě",
          "suffix_hu": "já",
          "examples": [
            {
              "form_hu": "lakik → lakom",
              "translation_cs": "bydlí → bydlím"
            },
            {
              "form_hu": "szeret → szeretek",
              "translation_cs": "má rád → mám rád"
            },
            {
              "form_hu": "kér → kérek",
              "translation_cs": "žádá → žádám / prosím si"
            }
          ]
        }
      ],
      "notes_cs": [
        "Základní slovníkový tvar ponecháváme ve slovníčku; osobní tvary se učíme postupně jako samostatné tvary.",
        "U slovesa lakik se v běžné mluvě objevuje také lakok; tato lekce procvičuje tradiční tvar lakom."
      ]
    }
  ],
