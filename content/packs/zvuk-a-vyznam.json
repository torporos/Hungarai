  "grammar": [
    {
      "id": "targy-t",
      "title_cs": "Předmět ve větě: koncovka -t",
      "level": "A1 · PRVNÍ VĚTY",
      "summary_cs": "Přímý předmět často poznáte podle koncovky -t.",
      "rule_cs": "Předmětová přípona se připojuje k podstatnému jménu; její podoba závisí na zakončení a kmeni. U některých slov na -a/-e se samohláska prodlouží, jinde se před příponou objeví spojovací samohláska nebo se změní kmen.",
      "groups": [
        {
          "name_cs": "Jídlo jako předmět",
          "suffix_hu": "-t",
          "examples": [
            {
              "form_hu": "almát",
              "translation_cs": "jablko (jako předmět)"
            },
            {
              "form_hu": "kávét",
              "translation_cs": "kávu"
            },
            {
              "form_hu": "kenyeret",
              "translation_cs": "chléb (jako předmět)"
            },
            {
              "form_hu": "tejet",
              "translation_cs": "mléko (jako předmět)"
            },
            {
              "form_hu": "jegyet",
              "translation_cs": "jízdenku"
            }
          ]
        }
      ],
      "notes_cs": [
        "Věta Kérek egy almát znamená Prosím si jablko.",
        "Tvar se někdy mění víc než pouhým přidáním -t; učte se ho spolu s novým slovem.",
        "Například kenyér → kenyeret mění kmenovou samohlásku; alma → almát prodlužuje koncové a."
      ]
    },
    {
      "id": "zdvorila-zadost",
      "title_cs": "Sloveso kér: od základního tvaru k „prosím si“",
      "level": "A1 · V OBCHODĚ",
      "summary_cs": "Slovníkový tvar slovesa je kér; kérek je jeho tvar pro „já“.",
      "rule_cs": "Maďarská slovesa se ve slovníku běžně uvádějí ve 3. osobě jednotného čísla: kér = žádá. V 1. osobě přidáme osobní koncovku: kérek = žádám / prosím si. Předmět žádosti mívá také vlastní koncovku.",
      "groups": [
        {
          "name_cs": "Užitečné věty",
          "suffix_hu": "kér → kérek",
          "examples": [
            {
              "form_hu": "kér",
              "translation_cs": "on / ona žádá · slovníkový tvar"
            },
            {
              "form_hu": "kérek",
              "translation_cs": "já žádám / prosím si"
            },
            {
              "form_hu": "Kérek egy kávét.",
              "translation_cs": "Prosím si kávu."
            },
            {
              "form_hu": "Kérek egy almát.",
              "translation_cs": "Prosím si jablko."
            },
            {
              "form_hu": "Mennyibe kerül?",
              "translation_cs": "Kolik to stojí?"
            }
          ]
        }
      ],
      "notes_cs": [
        "Egy znamená jeden nebo jedna; v běžné objednávce odpovídá českému neurčitému členu.",
        "Mennyi? znamená Kolik?"
      ]
    }
  ],
