  "grammar": [
    {
      "id": "prijemce-nak-nek",
      "title_cs": "Adresát: koncovka -nak/-nek",
      "level": "A1 · DOPIS A POŠTA",
      "summary_cs": "Koncovka označí člověka nebo skupinu, které něco dáváme či píšeme.",
      "rule_cs": "K podstatnému jménu připojte -nak po zadních samohláskách a -nek po předních. Tvar označuje příjemce: a családnak = rodině, a vendégnek = hostovi.",
      "groups": [
        {
          "name_cs": "Komu?",
          "suffix_hu": "-nak / -nek",
          "examples": [
            {
              "form_hu": "család + -nak → családnak",
              "translation_cs": "rodina → rodině"
            },
            {
              "form_hu": "vendég + -nek → vendégnek",
              "translation_cs": "host → hostovi"
            },
            {
              "form_hu": "A családnak levelet írok.",
              "translation_cs": "Píšu rodině dopis."
            }
          ]
        }
      ],
      "notes_cs": [
        "Volbu -nak/-nek řídí samohlásková harmonie.",
        "Vlastní jména se skloňují stejně: Anna → Annának, tedy Anně."
      ],
      "tags": [
        "q2"
      ]
    }
